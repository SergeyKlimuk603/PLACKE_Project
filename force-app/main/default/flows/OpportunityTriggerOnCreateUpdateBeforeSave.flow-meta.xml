<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_2</name>
        <label>Clean Loss Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.PLCK_LossReason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PLCK_LossReasonOtherDescription__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Closed_Won</name>
        <label>Closed Won</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Opportunity_Reopened</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>Clean_Block_Fields</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Blocked_Blocked_Reason</targetReference>
            </connector>
            <label>Clean Block Fields</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opportunity_Reopened</name>
        <label>Opportunity Reopened</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>Clean_Losss_Fields</name>
            <conditionLogic>1 or 2</conditionLogic>
            <conditions>
                <leftValueReference>StageNamechangedfromClosedLost</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StageNameChangedFromAnyToCloseWon</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_2</targetReference>
            </connector>
            <label>Clean Loss Fields</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>StageNameChangedFromAnyToCloseWon</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    TEXT($Record__Prior.StageName) &lt;&gt; &quot;Closed Won&quot;,
    TEXT($Record.StageName) = &quot;Closed Won&quot;
)</expression>
    </formulas>
    <formulas>
        <name>StageNamechangedfromClosedLost</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT($Record__Prior.StageName) = &quot;Closed Lost&quot;,
TEXT($Record.StageName) &lt;&gt; &quot;Closed Lost&quot;
)</expression>
    </formulas>
    <interviewLabel>Opportunity TriggerOnCreateUpdateBeforeSave {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Trigger On Create Update Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Clear_Blocked_Blocked_Reason</name>
        <label>Clear Blocked / Blocked Reason</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Reopened</targetReference>
        </connector>
        <inputAssignments>
            <field>PLCK_BlockedReasonOther__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PLCK_BlockedReason__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PLCK_Blocked__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Closed_Won</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
