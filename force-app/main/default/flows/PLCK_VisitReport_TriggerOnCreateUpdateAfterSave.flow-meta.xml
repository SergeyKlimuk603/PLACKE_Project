    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>{!VisitReport_EmailBody_Header}+

&quot;------------------------------&quot;+
IF( ISBLANK( {!recordVisitReport.OwnerId} ), &quot;&quot;, {!VisitReport_EmailBody_Owner} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Subject__c} ), &quot;&quot;, {!VisitReport_EmailBody_Subject} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Account__r.Name} ), &quot;&quot;, {!VisitReport_EmailBody_Account} )+
IF( ISBLANK( {!recordVisitReport.PLCK_StartDate__c} ), &quot;&quot;,{!VisitReport_EmailBody_StartDate} )+
IF( ISBLANK( {!recordVisitReport.PLCK_EndDate__c} ), &quot;&quot;,{!VisitReport_EmailBody_EndDate} )+
IF( ISBLANK( {!recordVisitReport.PLCK_LabOrder__c} ), &quot;&quot;,{!VisitReport_EmailBody_LabOrder} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Claim__c} ), &quot;&quot;,{!VisitReport_EmailBody_Claim} )+

IF( ISBLANK( {!recordVisitReport.PLCK_BackgroundInformation__c}), &quot;&quot;, {!VisitReport_EmailBody_BackgroundInformation} )+
IF( ISBLANK( {!recordVisitReport.PLCK_NextSteps__c} ), &quot;&quot;, {!VisitReport_EmailBody_NextSteps} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Problem__c} ), &quot;&quot;, {!VisitReport_EmailBody_Problem} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Action__c} ), &quot;&quot;, {!VisitReport_EmailBody_Action} )+
IF( ISBLANK( {!recordVisitReport.PLCK_Note__c} ), &quot;&quot;, {!VisitReport_EmailBody_Note} )+
&quot;------------------------------&quot;+
{!VisitReport_EmailBody_Footer}</expression>
    </formulas>
